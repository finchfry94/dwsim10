{
  "name": "dwsim-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DWSIM desktop app: Tauri shell, React frontend, .NET engine sidecar",
  "scripts": {
    "dev": "vite",
    "dev:engine": "cargo run -p dwsim-devserver",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "tauri": "tauri",
    "stage:engine": "node scripts/stage-engine.mjs",
    "bundle": "pnpm stage:engine && tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@xyflow/react": "^12.8.0",
    "d3-scale-chromatic": "^3.1.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/react": "^16.3.0",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
